use std::fs::File;
use std::io::{BufReader, Read};

mod rsb;

#[derive(Debug)]
enum Error {
    /// Failed to open the file
    Open(std::io::Error),

    /// Failed to read the file
    Read(std::io::Error),

    /// Failed to consume a field from the input
    Consume(&'static str, std::io::Error),

    /// Missing or wrong value for the map format version
    BadVersion,

    /// Missing or wrong value for the map magic value
    BadMagic,

    /// Failed to convert raw bytes to destination type
    BadConversion,
}

use binrw::{binrw, binread, BinRead, BinReaderExt, NullString, io::Cursor};
fn main() -> anyhow::Result<()> {
    rsb::load()?;
